# Un solo .env en la raíz. Lo carga contracts/settings.py con pydantic-settings.
# Cada paquete lee solo sus variables. Este fichero se commitea; el .env, nunca.
#
# OJO: nada de comentarios al final de una línea con valor. pydantic-settings se
# traga el comentario como parte del valor (una key vacía pasa a ser "# P1 ...").

# P2 · mundo
RCON_HOST=localhost
RCON_PORT=25575
RCON_PASSWORD=

# P1 y P3 · fenic (fin de llamada, sintéticas) usa gpt-5.6-luna con esta key
OPENAI_API_KEY=
# P1 (planner, memoria) y alternativa de fenic si no hay OpenAI
ANTHROPIC_API_KEY=

# P3 · HappyRobot. La clave de deployment (sk_live_) sirve tanto para los hooks
# como para la API de plataforma: comprobado contra GET /workflows/, que responde
# 200. No hace falta una de organización.
HAPPYROBOT_API_KEY=
# Opcional: una clave de organización, si algún día se necesita más alcance.
# Si está puesta, voice/northstars.py la prefiere sobre la de arriba.
HAPPYROBOT_ORG_KEY=
# API de plataforma de la región de la organización (la nuestra es EU)
HAPPYROBOT_API_BASE=https://platform.eu.happyrobot.ai/api/v2
# URL del trigger Webhook del workflow saliente: https://platform.happyrobot.ai/hooks/<slug>
HAPPYROBOT_HOOK_EVACUATION=
# Enlace de la web call del workflow entrante (trigger Web Call, enhanced security off)
HAPPYROBOT_WEBCALL_URL=

# P3 · Humalike (api.humalike.com), token ak_...
HUMALIKE_API_KEY=

# P3 · TypeSafe Jev (percepción durante la llamada). Sin clave, o con VELA_NO_JEV=true,
# voice cae a fenic con Literal sobre los ids del escenario (plan B).
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
VELA_NO_JEV=false

# P3 y P4 · cabecera X-Vela-Token de los webhooks (la misma en el workflow)
WEBHOOK_SHARED_TOKEN=

# P3 · se cambia en el último minuto
JUDGE_PHONE=
# El pueblo que NO arde recibe el aviso de que pueden llegarle vecinos del otro:
# su teléfono va aquí para que las dos llamadas no caigan en el mismo móvil.
NEIGHBOR_PHONE=

# P4 · demo | dev | replay
VELA_MODE=dev
VELA_REPLAY_FILE=fixtures/run_fake.jsonl  # P4 · el journal que sirve `make dev-dash`
VELA_REPLAY_SPEED=1.0               # P4 · 0 = tan rápido como pueda
VELA_REPLAY_LOOP=false              # P4 · repetir el journal al acabar
VELA_BRIDGES=true                   # P4 · action.requested → sim, call.requested → voice · false los apaga

# P4 · fuentes reales (SPEC-007) · VELA_FEEDS = off | live | recorded
VELA_FEEDS=off
# open_meteo,dgt,firms · vacío = todas
VELA_FEEDS_ONLY=
# capturas crudas: se guardan en live y se leen en recorded
VELA_FEEDS_DIR=fixtures/feeds
# NASA FIRMS, gratis: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Telegram (P3, Hugo): el vecino manda su ubicación al bot tras colgar. Bot de @BotFather.
# TELEGRAM_SECRET_TOKEN es el `secret_token` que se pasa a setWebhook (cualquier cadena larga).
TELEGRAM_BOT_TOKEN=
TELEGRAM_SECRET_TOKEN=
TELEGRAM_BOT_USERNAME=
VELA_NO_TELEGRAM=false
