# Un solo .env en la raíz. Lo carga contracts/settings.py con pydantic-settings.
# Cada paquete lee solo sus variables. Este fichero se commitea; el .env, nunca.
#
# OJO: nada de comentarios al final de una línea con valor. pydantic-settings se
# traga el comentario como parte del valor (una key vacía pasa a ser "# P1 ...").

# P2 · mundo
RCON_HOST=localhost
RCON_PORT=25575
RCON_PASSWORD=

# P1 y P3 · fenic (fin de llamada, sintéticas) usa gpt-5.6-luna con esta key
OPENAI_API_KEY=
# P1 (planner, memoria) y alternativa de fenic si no hay OpenAI
ANTHROPIC_API_KEY=

# P3 · HappyRobot. La clave de deployment (sk_live_) sirve tanto para los hooks
# como para la API de plataforma: comprobado contra GET /workflows/, que responde
# 200. No hace falta una de organización.
HAPPYROBOT_API_KEY=
# Opcional: una clave de organización, si algún día se necesita más alcance.
# Si está puesta, voice/northstars.py la prefiere sobre la de arriba.
HAPPYROBOT_ORG_KEY=
# API de plataforma de la región de la organización (la nuestra es EU)
HAPPYROBOT_API_BASE=https://platform.eu.happyrobot.ai/api/v2
# URL del trigger Webhook del workflow saliente: https://platform.happyrobot.ai/hooks/<slug>
HAPPYROBOT_HOOK_EVACUATION=
# Enlace de la web call del workflow entrante (trigger Web Call, enhanced security off)
HAPPYROBOT_WEBCALL_URL=

# P3 · Humalike (api.humalike.com), token ak_...
HUMALIKE_API_KEY=

# P3 · TypeSafe Jev (percepción durante la llamada). Sin clave, o con VELA_NO_JEV=true,
# voice cae a fenic con Literal sobre los ids del escenario (plan B).
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
VELA_NO_JEV=false

# P3 y P4 · cabecera X-Vela-Token de los webhooks (la misma en el workflow)
WEBHOOK_SHARED_TOKEN=

# P3 · se cambia en el último minuto
PHONE_PUEBLO_A=
# El pueblo que NO arde recibe el aviso de que pueden llegarle vecinos del otro:
# su teléfono va aquí para que las dos llamadas no caigan en el mismo móvil.
PHONE_PUEBLO_B=
# Los medios: al retén se le llama al detectar fuego; a la ambulancia solo si la piden
# y está libre. Sin número, esa llamada no se hace.
PHONE_FIRE_CREW=
PHONE_AMBULANCE=
# Todas las llamadas a pueblos a un solo móvil (la palanca de antes de salir):
PHONE_OVERRIDE=
# El vecino que llama: el móvil desde el que el visitante marca al 112 de la demo. No se
# le llama; sirve para reconocer su entrante (call.started.known_caller).
PHONE_NEIGHBOR=
# El número al que marca el vecino (trigger "Inbound to number" de citizen_report_phone).
# Se enseña en la landing y en la pantalla de espera del dashboard.
HAPPYROBOT_INBOUND_NUMBER=

# P4 · la /demo autoservicio (landing externa → POST /api/run con `phones` → dashboard).
# Los cinco PHONE_* de arriba son los valores por defecto; un run de la /demo trae los
# suyos en la petición y el gateway los aplica solo mientras dura ese run.
# Orígenes con permiso para llamar a la API desde otro dominio (la landing), por coma:
VELA_CORS_ORIGINS=
# URL pública del dashboard (lo que la landing abre tras arrancar) y de la landing:
VELA_PUBLIC_URL=
VELA_LANDING_URL=
# Un run se para solo a los N segundos. 0 = nunca (ensayos a mano con make demo).
VELA_RUN_MAX_S=420
# Jugador-cámara del cliente headless: el gateway lo pone en espectador y en el plano
# de VELA_CAM_SHOT al arrancar cada run. Vacío = nadie (la demo de la segunda pantalla).
VELA_CAM_PLAYER=
# El encuadre fijo de esa cámara, de `sim.camera.shots()`: aguila | valle | escorzo.
# `aguila` encuadra todo el escenario (pueblos, fuego, hospital y refugio) a Y=191, que
# es lo más alto que aguanta sin niebla con renderDistance:16. Si bajas el renderDistance
# del cliente para ganar fps, baja también RENDER_DISTANCE_CHUNKS en sim/camera.py.
VELA_CAM_SHOT=aguila
# Dónde sirve MediaMTX el HLS del Minecraft para el dashboard.
VELA_CAM_HLS_URL=/cam/vela/index.m3u8

# P4 · demo | dev | replay
VELA_MODE=dev
# P4 · el journal que sirve `make dev-dash`; velocidad (0 = tan rápido como pueda);
# repetir al acabar; y los puentes action.requested → sim, call.requested → voice.
VELA_REPLAY_FILE=fixtures/run_fake.jsonl
VELA_REPLAY_SPEED=1.0
VELA_REPLAY_LOOP=false
VELA_BRIDGES=true

# P4 · fuentes reales (SPEC-007) · VELA_FEEDS = off | live | recorded
VELA_FEEDS=off
# open_meteo,dgt,firms · vacío = todas
VELA_FEEDS_ONLY=
# capturas crudas: se guardan en live y se leen en recorded
VELA_FEEDS_DIR=fixtures/feeds
# NASA FIRMS, gratis: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Telegram (P3, Hugo): el vecino manda su ubicación al bot tras colgar. Bot de @BotFather.
# TELEGRAM_SECRET_TOKEN es el `secret_token` que se pasa a setWebhook (cualquier cadena larga).
TELEGRAM_BOT_TOKEN=
TELEGRAM_SECRET_TOKEN=
TELEGRAM_BOT_USERNAME=
VELA_NO_TELEGRAM=false

# Despliegue (infra/deploy, `make deploy-up`). Solo los lee docker compose; el gateway
# de local los ignora. El dominio apunta al VPS y Caddy saca el certificado solo.
DOMAIN=
# Correo para Let's Encrypt: te avisa si el certificado va a caducar. Vacío = sin aviso
# (el certificado se saca igual).
ACME_EMAIL=
# La MISMA versión que el jar de infra/server (hoy paper-1.21.11): cliente y servidor
# tienen que coincidir o el cliente dice «outdated server».
MC_VERSION=1.21.11
# El jugador-cámara (es el VELA_CAM_PLAYER del gateway dentro de compose).
MC_PLAYER=vela_cam
# Email de la cuenta de Minecraft Java ya logueada con `make deploy-login`; vacío =
# el cliente entra offline con MC_PLAYER (Paper va con online-mode=false).
MC_LOGIN=
# Recursos de la cámara: resolución, fps del stream, memoria del cliente y CPUs máximas.
CAM_RES=1280x720
CAM_FPS=15
MC_XMX=3G
CAM_CPUS=4
PAPER_MEMORY=4G
