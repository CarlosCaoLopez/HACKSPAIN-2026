# Un solo .env en la raíz. Lo carga contracts/settings.py con pydantic-settings.
# Cada paquete lee solo sus variables. Este fichero se commitea; el .env, nunca.

RCON_HOST=localhost                 # P2
RCON_PORT=25575
RCON_PASSWORD=

ANTHROPIC_API_KEY=                  # P3 (fenic)
OPENAI_API_KEY=                     # P1 · planner (GPT-5.6 Luna)

HAPPYROBOT_API_KEY=                 # P3
HAPPYROBOT_HOOK_EVACUATION=         # P3, la URL del incoming hook
humalike_API_KEY=                  # P3

WEBHOOK_SHARED_TOKEN=               # P3 y P4

JUDGE_PHONE=                        # P3, se cambia en el último minuto

VELA_MODE=dev                       # P4 · demo | dev | replay
