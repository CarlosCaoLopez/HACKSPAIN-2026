{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // REQ-010. `skipLibCheck` solo afecta a los .d.ts de node_modules, nunca a
    // nuestro código: sin él, un tipo roto de una dependencia bloquea la demo.
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true
  },
  // `vite.config.ts` entra aquí en vez de en un proyecto referenciado: un
  // composite no puede llevar `noEmit`, y no merece un fichero extra.
  "include": ["src", "vite.config.ts"]
}
