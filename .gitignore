.env
.venv/
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.egg-info/

node_modules/
apps/dashboard/dist/
# Se genera con `make types` desde contracts. Nunca se escribe a mano.
apps/dashboard/src/types.ts

# Salida de los runs. Cuando uno sale bien, se fuerza con `git add -f`:
# son vuestro dataset y la prueba de que el aprendizaje funciona.
runs/*
!runs/.gitkeep

# Cuaderno personal de Nacho. No es contrato del equipo.
docs-nacho/
claude-nacho.md

# Capturas de UIs ajenas que uso como referencia visual del dashboard.
# Material de terceros: se mira, no se commitea.
refs-dashboard/

# El mundo NO se versiona: se genera. `make world` lo reconstruye entero desde
# scenarios/*.yaml en unos segundos, así que la fuente de verdad es ese texto y no
# 34 MB de ficheros de región binarios que además cambian en cada arranque del
# servidor — seis de ellos sin tocar nada — y que cuatro personas no podrían
# fusionar. El backbone pedía commitearlo; medido, no es viable.
infra/server/logs/
infra/server/cache/
infra/server/*.jar
# Paper lo reescribe en cada arranque. El versionado es server.properties.template.
infra/server/server.properties
infra/server/eula.txt
infra/server/banned-*.json
infra/server/ops.json
infra/server/whitelist.json
infra/server/usercache.json
infra/server/versions/
infra/server/libraries/
infra/server/plugins/
infra/server/config/
# Config que Paper regenera en cada arranque con sus defaults.
infra/server/bukkit.yml
infra/server/spigot.yml
infra/server/commands.yml
infra/server/help.yml
infra/server/permissions.yml
infra/server/version_history.json
# La demo es un valle en el overworld. Estos dos no se usan jamás.
infra/server/world/
infra/server/world_nether/
infra/server/world_the_end/

# Notas de planificación personales de Carlos
docs/carlos/

# fenic deja bases locales al crear sesión
*.duckdb
*.duckdb.wal
.DS_Store

# worktrees de los subagentes de Claude
.claude/worktrees/

# tsc --build deja su caché de incrementales en el paquete del dashboard
apps/dashboard/*.tsbuildinfo
