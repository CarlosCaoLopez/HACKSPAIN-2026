.env
.venv/
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.egg-info/

node_modules/
apps/dashboard/dist/
# Se genera con `make types` desde contracts. Nunca se escribe a mano.
apps/dashboard/src/types.ts

# Salida de los runs. Cuando uno sale bien, se fuerza con `git add -f`:
# son vuestro dataset y la prueba de que el aprendizaje funciona.
runs/*
!runs/.gitkeep

# Cuaderno personal de Nacho. No es contrato del equipo.
docs-nacho/
claude-nacho.md

# Capturas de UIs ajenas que uso como referencia visual del dashboard.
# Material de terceros: se mira, no se commitea.
refs-dashboard/

# El mundo construido a mano SÍ se commitea (infra/server/world/), el resto no.
infra/server/logs/
infra/server/cache/
infra/server/*.jar
